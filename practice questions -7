#include <stdio.h>

int main() {
    int a[] = {3,7,3,5,2,5,9,2};
    int n = 8;

    for(int i = 0; i < n; i++) {
        int unique = 1;

        for(int j = 0; j < i; j++)
            if(a[i] == a[j])
                unique = 0;

        if(unique)
            printf("%d ", a[i]);
    }

    return 0;
}
