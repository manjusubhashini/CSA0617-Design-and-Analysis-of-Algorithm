#include <stdio.h>

int m,n,N;

int solve(int i, int j, int steps) {
    if(i<0 || i>=m || j<0 || j>=n)
        return 1;

    if(steps==0)
        return 0;

    return solve(i-1,j,steps-1) +
           solve(i+1,j,steps-1) +
           solve(i,j-1,steps-1) +
           solve(i,j+1,steps-1);
}

int main() {
    m=2; n=2; N=2;
    printf("%d", solve(0,0,N));
    return 0;
}
