#include <stdio.h>
#include <string.h>

int main() {
    char s[] = "abbxxxxzzy";
    int n = strlen(s);
    int start = 0;

    for(int i=1;i<=n;i++) {
        if(i==n || s[i]!=s[start]) {
            if(i-start >= 3)
                printf("[%d,%d]\n", start, i-1);

            start=i;
        }
    }

    return 0;
}
