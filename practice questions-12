#include <stdio.h>

int max(int a, int b) {
    return a > b ? a : b;
}

int rob(int a[], int l, int r) {
    int prev=0, curr=0;

    for(int i=l;i<=r;i++) {
        int next = max(curr, prev+a[i]);
        prev = curr;
        curr = next;
    }
    return curr;
}

int main() {
    int a[] = {2,3,2};
    int n=3;

    printf("%d", max(rob(a,0,n-2), rob(a,1,n-1)));

    return 0;
}
