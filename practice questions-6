#include <stdio.h>

int main() {
    int a[] = {5,2,8,1,9};
    int n = 5, temp;

    if(n == 0) {
        printf("List is empty");
        return 0;
    }

    for(int i = 0; i < n-1; i++)
        for(int j = i+1; j < n; j++)
            if(a[i] > a[j]) {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }

    printf("Maximum = %d", a[n-1]);
    return 0;
}
