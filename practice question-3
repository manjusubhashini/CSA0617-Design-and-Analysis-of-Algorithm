#include <stdio.h>
int main() {
    int a[] = {1, 2, 1, 3};
    int n = 4, ans = 0, seen[100] = {0};
    for (int i = 0; i < n; i++) {
        int cnt = 0, used[100] = {0};
        for (int j = i; j < n; j++) {
            if (!used[a[j]]) {
                used[a[j]] = 1;
                cnt++;
          }
            if (!seen[cnt]) {
                seen[cnt] = 1;
                ans++;
            }
        }
    }
    printf("%d", ans);
    return 0;
}
