#include <stdio.h>

int main() {
    int a[] = {-9,3,4,6,8,9,10,30};
    int n = 8, key = 10;
    int low = 0, high = n-1;

    while(low <= high) {
        int mid = (low + high) / 2;

        if(a[mid] == key) {
            printf("Element %d is found at position %d", key, mid);
            return 0;
        }
        else if(a[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    printf("Element %d is not found", key);
    return 0;
}
